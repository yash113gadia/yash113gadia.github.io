{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/leads/:slug", "destination": "/leads/:slug/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
